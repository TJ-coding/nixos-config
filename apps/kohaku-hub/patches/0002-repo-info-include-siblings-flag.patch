+++ b/src/kohakuhub/api/repo/routers/info.py
@@ -172,6 +172,7 @@
     repo_name: str,
     request: Request,
     fallback: bool = True,
+    include_siblings: bool = Query(True),
     user: User | None = Depends(get_optional_user),
 ):
     """Get repository information (without revision).
@@ -250,14 +251,17 @@
